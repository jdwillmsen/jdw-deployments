#!/usr/bin/env bash
# Console access to the Minecraft Bedrock server running in Kubernetes.
#
# The server ships `send-command`, which writes to the server's stdin. Driving
# it directly through kubectl means hand-building the JSON that `tellraw`
# wants inside two layers of shell quoting, which is where the mistakes are.
# This wraps that.
set -uo pipefail

NAMESPACE="${MC_NAMESPACE:-jdwillmsen-prd}"
SELECTOR="${MC_SELECTOR:-app=jdwillmsen-minecraft-fwb-prd-minecraft-bedrock}"
SELF="$(basename "$0")"

# Errors go to stdout as structured text, not stderr: an agent reading only
# stdout must still see why a command failed rather than an empty result.
err() {
  echo "error: $1"
  [ $# -gt 1 ] && echo "hint: $2"
  exit 1
}

# Every grep below that reads `kubectl logs` passes -a.
#
# The Bedrock console log contains binary bytes, and grep treats a stream with
# any as binary: it prints "binary file matches" and produces no matching
# lines, so a parse built on it silently yields nothing. That made `mc players`
# report 0 while four people were online, and `mc announce` unable to see the
# server's own rejection of a malformed payload -- both observed on 2026-09-08.
# The failure is silent by construction, so the flag belongs on every one.
server_pod() {
  local pod
  pod="$(kubectl get pods -n "$NAMESPACE" -l "$SELECTOR" \
    -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)"
  [ -n "$pod" ] || err "no server pod in namespace $NAMESPACE" \
    "check MC_NAMESPACE and MC_SELECTOR, or: kubectl get pods -n $NAMESPACE"
  printf '%s' "$pod"
}

# send-command returns 0 whether or not the server accepted the command, and
# echoes nothing back for most of them. Callers are told that rather than left
# to assume a silent success means delivery.
send() {
  local pod="$1"; shift
  kubectl exec -n "$NAMESPACE" "$pod" -- send-command "$@" >/dev/null 2>&1 \
    || err "could not reach the server console" "the pod may be restarting: $SELF status"
}

cmd_status() {
  local pod ready restarts online
  pod="$(server_pod)" || exit 1
  ready="$(kubectl get pod -n "$NAMESPACE" "$pod" \
    -o jsonpath='{.status.containerStatuses[0].ready}' 2>/dev/null)"
  restarts="$(kubectl get pod -n "$NAMESPACE" "$pod" \
    -o jsonpath='{.status.containerStatuses[0].restartCount}' 2>/dev/null)"

  echo "pod: $pod"
  echo "ready: ${ready:-unknown}"
  echo "restarts: ${restarts:-unknown}"

  if [ "$ready" = "true" ]; then
    send "$pod" list
    sleep 2
    online="$(kubectl logs -n "$NAMESPACE" "$pod" --tail=20 2>/dev/null \
      | grep -a -oE 'There are [0-9]+/[0-9]+ players online' | tail -1 | grep -oE '[0-9]+/[0-9]+')"
    echo "players: ${online:-unknown}"
  fi

  echo
  echo "help:"
  echo "  $SELF say <message>              broadcast a plain message"
  echo "  $SELF announce <message>         broadcast it highlighted"
  echo "  $SELF players                    who is online"
  echo "  $SELF run <command> [args...]    any console command"
}

cmd_players() {
  local pod names count
  pod="$(server_pod)" || exit 1
  send "$pod" list
  sleep 2
  count="$(kubectl logs -n "$NAMESPACE" "$pod" --tail=20 2>/dev/null \
    | grep -a -oE 'There are [0-9]+/[0-9]+ players online' | tail -1 | grep -oE '^There are [0-9]+' | grep -oE '[0-9]+')"
  names="$(kubectl logs -n "$NAMESPACE" "$pod" --tail=20 2>/dev/null \
    | grep -a -A1 'players online' | tail -1 | tr -d '\r')"

  # An empty result is stated rather than printed as nothing, so a caller can
  # tell "nobody online" apart from "the command did not work".
  if [ "${count:-0}" = "0" ] || [ -z "$names" ] || [[ "$names" == *"players online"* ]]; then
    echo "players: 0"
    echo "online: none"
    return 0
  fi
  echo "players: ${count:-unknown}"
  echo "online:"
  echo "$names" | tr ',' '\n' | sed 's/^ *//;s/^/  - /'
}

cmd_say() {
  [ $# -gt 0 ] || err "say needs a message" "$SELF say Server restarting in 5 minutes"
  local pod; pod="$(server_pod)" || exit 1
  send "$pod" say "$*"
  echo "sent: say"
  echo "message: $*"

  # say is genuinely unverifiable: the server prints nothing for it, success
  # or failure. Rather than assert a delivery that cannot be checked, report
  # whether anyone was there to receive it, which is the part that can be.
  send "$pod" list
  sleep 2
  local online
  online="$(kubectl logs -n "$NAMESPACE" "$pod" --tail=20 2>/dev/null \
    | grep -a -oE 'There are [0-9]+/[0-9]+ players online' | tail -1 | grep -oE '[0-9]+/[0-9]+')"
  echo "delivered: unconfirmed"
  echo "recipients: ${online:-unknown}"
  echo
  echo "help:"
  echo "  the server prints nothing for say, so delivery cannot be confirmed"
  echo "  $SELF announce <message>    reports delivery, and stands out in chat"
}

cmd_announce() {
  [ $# -gt 0 ] || err "announce needs a message" "$SELF announce Backup starting now"
  local pod json message; pod="$(server_pod)" || exit 1
  message="$*"

  # Bedrock's tellraw is not Java's: it takes a top-level {"rawtext":[...]}
  # wrapper. Built with a JSON encoder rather than string interpolation so a
  # quote or backslash in the message cannot produce malformed JSON that the
  # server silently rejects.
  json="$(MC_MSG="$message" python3 -c '
import json, os
print(json.dumps({"rawtext": [{"text": "§e" + os.environ["MC_MSG"]}]}))
' 2>/dev/null)"
  [ -n "$json" ] || err "could not encode the message" "python3 is required for announce; $SELF say works without it"

  # The console is a shared log, so the read-back below has to be bounded to
  # what this command produced. A --tail window instead matches whatever
  # happened to be there -- including an error from a previous command, which
  # reports a healthy send as rejected. One second of slack absorbs clock skew
  # between here and the node.
  local since
  since="$(date -u -d '1 second ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)"

  send "$pod" tellraw @a "$json"
  sleep 2

  # tellraw does report failure, unlike say, so the outcome is read back
  # rather than assumed. Two signatures matter: a rejected payload, and a
  # well-formed one that reached nobody.
  local tail
  tail="$(kubectl logs -n "$NAMESPACE" "$pod" --since-time="$since" 2>/dev/null)"
  echo "sent: tellraw"
  echo "message: $message"
  if grep -a -q "Syntax error" <<<"$tail"; then
    echo "delivered: no"
    echo "reason: the server rejected the payload"
    echo "server: $(grep -a -o 'Syntax error.*' <<<"$tail" | tail -1)"
    exit 1
  elif grep -a -q "No targets matched selector" <<<"$tail"; then
    echo "delivered: no"
    echo "reason: nobody was online to receive it"
    echo
    echo "help:"
    echo "  $SELF players    confirm who is on before announcing"
    exit 0
  fi
  echo "delivered: yes"
}

cmd_run() {
  [ $# -gt 0 ] || err "run needs a command" "$SELF run gamerule showcoordinates true"
  local pod; pod="$(server_pod)" || exit 1
  send "$pod" "$@"
  sleep 2
  echo "ran: $*"
  echo "output:"
  kubectl logs -n "$NAMESPACE" "$pod" --tail=5 2>/dev/null | sed 's/^/  /'
}

# --- presence ----------------------------------------------------------------
#
# A thin client over the agent's /v1 presence API. The API is not published
# outside the cluster, so each call port-forwards to the agent's metrics
# Service, which serves /v1 on the same port, for its own lifetime.

RELEASE="${MC_RELEASE:-jdwillmsen-minecraft-fwb-prd}"
PRESENCE_PORT="${MC_PRESENCE_PORT:-9090}"
# global.presence.operatorToken.name in the chart. The key mirrors the
# chart's presence.tokenKey helper, which swaps - for _.
PRESENCE_TOKEN_NAME="tools-mc"
PRESENCE_TOKEN_KEY="presence_token_${PRESENCE_TOKEN_NAME//-/_}"
PRESENCE_OFF_HINT="presence may be off (global.presence.enabled in charts/minecraft-fwb/values.yaml)"

# Usage errors exit 2 rather than err's 1, so a caller can tell "you asked
# wrongly" from "what you asked for could not be done".
usage_err() {
  echo "error: $1"
  [ $# -gt 1 ] && echo "hint: $2"
  exit 2
}

# xtrace prints every assignment expanded, so it is paused wherever the token
# is in hand; `bash -x tools/mc` stays usable for debugging without leaking it.
xtrace_pause() {
  case $- in
    *x*) XTRACE_WAS_ON=1; set +x ;;
    *) XTRACE_WAS_ON="" ;;
  esac
}
xtrace_resume() {
  if [ -n "$XTRACE_WAS_ON" ]; then set -x; fi
}

presence_need() {
  command -v jq >/dev/null 2>&1 || err "jq is required for presence" "install jq, then re-run"
  command -v curl >/dev/null 2>&1 || err "curl is required for presence" "install curl, then re-run"
}

# MC_PRESENCE_URL skips the port-forward, for a caller that already has a
# route in (and for the tests, which have no cluster).
presence_connect() {
  if [ -n "${MC_PRESENCE_URL:-}" ]; then
    PRESENCE_BASE="$MC_PRESENCE_URL"
    return 0
  fi
  PF_LOG="$(mktemp)"
  kubectl port-forward -n "$NAMESPACE" "svc/${RELEASE}-server-agent-metrics" ":$PRESENCE_PORT" \
    >"$PF_LOG" 2>&1 &
  PF_PID=$!
  trap 'kill "$PF_PID" 2>/dev/null; rm -f "$PF_LOG"' EXIT
  local port="" _
  for _ in $(seq 1 50); do
    port="$(grep -oE '127\.0\.0\.1:[0-9]+' "$PF_LOG" | head -1 | cut -d: -f2)"
    [ -n "$port" ] && break
    kill -0 "$PF_PID" 2>/dev/null || break
    sleep 0.1
  done
  [ -n "$port" ] || err "could not reach the presence API" \
    "the server agent may be off or restarting: kubectl get svc,pods -n $NAMESPACE | grep ${RELEASE}-server-agent"
  PRESENCE_BASE="http://127.0.0.1:$port"
}

# The token lives only in this variable: never echoed, never in argv (which
# any user on the machine can read from ps), never in a file. It travels
# through pipes from builtins, because a here-string may be spooled to a temp
# file.
presence_token() {
  xtrace_pause
  if [ -n "${MC_PRESENCE_TOKEN:-}" ]; then
    PRESENCE_TOKEN="$MC_PRESENCE_TOKEN"
    xtrace_resume
    return 0
  fi
  local encoded
  if ! encoded="$(kubectl get secret -n "$NAMESPACE" "${RELEASE}-presence" \
      -o jsonpath="{.data.$PRESENCE_TOKEN_KEY}" 2>/dev/null)"; then
    err "no operator token in secret ${RELEASE}-presence" \
      "$PRESENCE_OFF_HINT, or: kubectl get externalsecret -n $NAMESPACE ${RELEASE}-presence"
  fi
  PRESENCE_TOKEN="$(printf '%s' "$encoded" | base64 -d 2>/dev/null)"
  encoded=""
  [ -n "$PRESENCE_TOKEN" ] || err "no operator token in secret ${RELEASE}-presence" \
    "key $PRESENCE_TOKEN_KEY is missing or empty; check it has synced: kubectl get externalsecret -n $NAMESPACE ${RELEASE}-presence"
  xtrace_resume
}

# api METHOD PATH [JSON]; sets API_STATUS (000 when nothing answered) and
# API_BODY.
api() {
  local out
  local -a args=(-sS -X "$1" --max-time 10 -H @- -w '\n%{http_code}')
  [ $# -gt 2 ] && args+=(-H 'Content-Type: application/json' --data-binary "$3")
  xtrace_pause
  out="$(printf 'Authorization: Bearer %s\n' "$PRESENCE_TOKEN" | curl "${args[@]}" "$PRESENCE_BASE$2" 2>/dev/null)" || true
  xtrace_resume
  API_STATUS="${out##*$'\n'}"
  API_BODY="${out%$'\n'*}"
  [[ "$API_STATUS" =~ ^[0-9]{3}$ ]] || { API_STATUS=000; API_BODY=""; }
}

# Translates a failed call into the CLI's own error. The API's message is ours
# and safe to show; the raw body never is printed.
api_fail() {
  local code msg
  code="$(jq -r '.code // empty' <<<"$API_BODY" 2>/dev/null)"
  msg="$(jq -r '.message // empty' <<<"$API_BODY" 2>/dev/null)"
  case "$API_STATUS" in
    000) err "the presence API did not answer" "the agent may be restarting: $SELF presence ls" ;;
    401) err "the presence API rejected the operator token" \
           "the secret may have rotated since this ran; re-run, or: kubectl get externalsecret -n $NAMESPACE ${RELEASE}-presence" ;;
    403) err "the operator token may not do this${msg:+: $msg}" "check its scopes in global.presence of the chart" ;;
    # Every 404 from a mounted API carries the contract's Error. A bare one is
    # Go's mux answering for a /v1 the agent never mounted.
    404) [ -n "$code" ] || err "the agent is not serving the presence API" \
           "$PRESENCE_OFF_HINT, or the agent is still starting; retry in a minute"
         err "${msg:-no such actor or group}" "$SELF presence ls" ;;
    503) err "the presence store is unavailable${msg:+: $msg}" \
           "the bots keep their last state meanwhile; retry: $SELF presence ls" ;;
    *)   err "the presence API answered $API_STATUS${msg:+: $msg}" "$SELF presence ls" ;;
  esac
}

# TOON scalar: quoted only where the format requires it.
TOON_JQ='def tv: if . == null then "null"
  elif (type == "boolean" or type == "number") then tostring
  elif test("^$|^[\\s-]|\\s$|[,:\"\\\\\\[\\]{}#]|^(true|false|null)$|^-?[0-9]") then tojson
  else . end;'

presence_actors() {
  api GET /v1/actors
  [ "$API_STATUS" = 200 ] || api_fail
  jq -e 'type == "array"' >/dev/null 2>&1 <<<"$API_BODY" \
    || err "the presence API answered something other than a list of actors" \
         "the agent and this tool may disagree on the API version: $SELF presence ls"
  ACTORS="$API_BODY"
}

presence_ls() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) presence_usage; return 0 ;;
      *) usage_err "unknown argument for presence ls: $1" "valid flags for presence ls: --help" ;;
    esac
  done
  presence_need; presence_connect; presence_token; presence_actors
  jq -r "$TOON_JQ"'
    "count: \(length)",
    if length == 0 then "actors: none" else
      "actors[\(length)]{id,effective,source,until,connected}:",
      (.[] | "  " + ([.id, .effective,
                      (if .override then .override.set_by else "default" end),
                      (.override.until // null),
                      (if .status then .status.connected else null end)] | map(tv) | join(",")))
    end,
    (([.[].groups[]?] | unique) + ["all"]) as $g
    | "groups[\($g | length)]: " + ($g | map(tv) | join(",")),
    "help[2]:",
    "  Run `'"$SELF"' presence park <id|group|all> --reason \"<text>\" [--for 2h]` to park",
    "  Run `'"$SELF"' presence unpark <id|group|all>` to return to the default"
  ' <<<"$ACTORS"
}

presence_usage() {
  cat <<USAGE
$SELF presence — park and restore the accounts that hold the world's chunks

  $SELF presence [ls]                                   every actor and its state
  $SELF presence park <target> --reason <text> [--for <duration>]
  $SELF presence unpark <target>                        back to the default in git

  <target>    an actor id, a group, or all
  --for       Go duration (30m, 2h); without it the park lasts until unparked
  --reason    required; recorded with the override

examples:
  $SELF presence park bots --for 2h --reason "farm rebuild"
  $SELF presence unpark bots

environment:
  MC_RELEASE          release name (default: $RELEASE)
  MC_PRESENCE_PORT    agent port serving /v1 (default: $PRESENCE_PORT)
  MC_PRESENCE_TOKEN   operator token, instead of reading the cluster secret
  MC_PRESENCE_URL     API base URL, instead of a port-forward
USAGE
}

ID_RE='^[a-z0-9][a-z0-9-]{0,62}$'

# Resolves a target against the live actor list, so a typo is refused before
# anything is written. Sets TARGET_KIND (actor|group) and TARGET_IDS.
presence_resolve() {
  local target="$1"
  if jq -e --arg t "$target" 'any(.[]; .id == $t)' <<<"$ACTORS" >/dev/null; then
    TARGET_KIND=actor
  elif [ "$target" = all ] || jq -e --arg t "$target" 'any(.[]; (.groups // []) | index($t))' <<<"$ACTORS" >/dev/null; then
    TARGET_KIND=group
  else
    err "unknown target: $target" \
      "targets are $(jq -r '[.[].id] + ([.[].groups[]?] | unique) + ["all"] | join(", ")' <<<"$ACTORS")"
  fi
  mapfile -t TARGET_IDS < <(jq -r --arg t "$target" --arg k "$TARGET_KIND" '
    .[] | select($k == "group" and ($t == "all" or ((.groups // []) | index($t)))
                 or ($k == "actor" and .id == $t)) | .id' <<<"$ACTORS")
}

presence_park() {
  local target="" duration="" reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) presence_usage; return 0 ;;
      --for) [ $# -gt 1 ] || usage_err "--for needs a duration" "$SELF presence park bots --for 2h --reason \"<text>\""
             duration="$2"; shift 2 ;;
      --reason) [ $# -gt 1 ] || usage_err "--reason needs text" "$SELF presence park bots --reason \"<text>\""
                reason="$2"; shift 2 ;;
      -*) usage_err "unknown flag for presence park: $1" "valid flags for presence park: --for, --reason, --help" ;;
      *) [ -z "$target" ] || usage_err "presence park takes one target, got a second: $1" "$SELF presence park <id|group|all> --reason \"<text>\""
         target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || usage_err "presence park needs a target" "$SELF presence park <id|group|all> --reason \"<text>\" [--for 2h]"
  [[ "$target" =~ $ID_RE ]] || usage_err "not an actor id, group or all: $target" "$SELF presence ls"
  [ -n "${reason// /}" ] || usage_err "--reason is required" "$SELF presence park $target --reason \"<why>\""
  # The agent refuses a zero duration, and one without a non-zero digit is zero.
  if [ -n "$duration" ] && ! { [[ "$duration" =~ ^([0-9]+(\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$ ]] && [[ "$duration" =~ [1-9] ]]; }; then
    usage_err "not a positive Go duration: $duration" "use units like 30m, 2h or 1h30m"
  fi

  presence_need; presence_connect; presence_token; presence_actors
  presence_resolve "$target"

  local body result
  if [ "$TARGET_KIND" = actor ]; then
    # The version read is the one written against: a 409 means someone else
    # changed this actor in between, and their change is shown, not overwritten.
    local version
    version="$(jq -r --arg t "$target" '.[] | select(.id == $t) | .override.version // 0' <<<"$ACTORS")"
    body="$(jq -nc --arg r "$reason" --arg d "$duration" --argjson v "$version" \
      '{state: "parked", reason: $r, version: $v} + (if $d == "" then {} else {duration: $d} end)')"
    api PUT "/v1/actors/$target/presence" "$body"
    if [ "$API_STATUS" = 409 ]; then
      echo "error: $target was changed by someone else while this ran"
      jq -r "$TOON_JQ"'.current | "current: " + ([.actor_id, .effective, (.override.set_by // "default")] | map(tv) | join(","))' \
        <<<"$API_BODY" 2>/dev/null
      echo "hint: $SELF presence ls, then re-run if it is still wanted"
      exit 1
    fi
    [ "$API_STATUS" = 200 ] || api_fail
    result="[$API_BODY]"
  else
    body="$(jq -nc --arg r "$reason" --arg d "$duration" \
      '{state: "parked", reason: $r, version: 0} + (if $d == "" then {} else {duration: $d} end)')"
    api PUT "/v1/groups/$target/presence" "$body"
    [ "$API_STATUS" = 200 ] || api_fail
    result="$API_BODY"
  fi
  jq -r "$TOON_JQ"'
    "parked[\(length)]{id,effective,until}:",
    (.[] | "  " + ([.actor_id, .effective, (.override.until // null)] | map(tv) | join(","))),
    "help[1]:",
    "  Run `'"$SELF"' presence unpark '"$target"'` to return to the default"
  ' <<<"$result"
  # A parked agent reads no chat, so without an expiry nothing but this tool
  # or the API brings it back.
  if [ -z "$duration" ] && jq -e --args '[.[] | select(.kind == "agent" and (.id | IN($ARGS.positional[])))] | length > 0' \
      "${TARGET_IDS[@]}" <<<"$ACTORS" >/dev/null; then
    echo "warning: agent parked with no expiry; chat cannot unpark it; run: $SELF presence unpark agent"
  fi
}

presence_unpark() {
  local target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) presence_usage; return 0 ;;
      -*) usage_err "unknown flag for presence unpark: $1" "valid flags for presence unpark: --help" ;;
      *) [ -z "$target" ] || usage_err "presence unpark takes one target, got a second: $1" "$SELF presence unpark <id|group|all>"
         target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || usage_err "presence unpark needs a target" "$SELF presence unpark <id|group|all>"
  [[ "$target" =~ $ID_RE ]] || usage_err "not an actor id, group or all: $target" "$SELF presence ls"

  presence_need; presence_connect; presence_token; presence_actors
  presence_resolve "$target"

  # There is no group DELETE, so a group is removed one member at a time. An
  # actor with no override is already at its default and is left alone, which
  # makes a repeat of this command a no-op rather than an error.
  local id rows=() unchanged=()
  for id in "${TARGET_IDS[@]}"; do
    if ! jq -e --arg id "$id" '.[] | select(.id == $id) | .override' <<<"$ACTORS" >/dev/null; then
      unchanged+=("$id")
      continue
    fi
    api DELETE "/v1/actors/$id/presence"
    if [ "$API_STATUS" != 200 ]; then
      [ "${#rows[@]}" -eq 0 ] || printf 'unparked_before_failure: %s\n' "$(printf '%s\n' "${rows[@]}" | cut -d, -f1 | paste -sd, -)"
      api_fail
    fi
    rows+=("$(jq -r "$TOON_JQ"'[.actor_id, .effective] | map(tv) | join(",")' <<<"$API_BODY")")
  done
  if [ "${#rows[@]}" -eq 0 ]; then
    echo "unparked: 0 of ${#TARGET_IDS[@]} had an override, nothing to do (no-op)"
    return 0
  fi
  echo "unparked[${#rows[@]}]{id,effective}:"
  printf '  %s\n' "${rows[@]}"
  [ "${#unchanged[@]}" -eq 0 ] || echo "unchanged[${#unchanged[@]}]: $(IFS=,; echo "${unchanged[*]}")"
}

cmd_presence() {
  case "${1:-}" in
    ""|ls)  shift || true; presence_ls "$@" ;;
    park)   shift; presence_park "$@" ;;
    unpark) shift; presence_unpark "$@" ;;
    -h|--help|help) presence_usage ;;
    *) usage_err "unknown presence command: $1" "$SELF presence --help" ;;
  esac
}

usage() {
  cat <<EOF
$SELF — console access to the Minecraft Bedrock server

  $SELF                            server status and who is online
  $SELF say <message>              broadcast a plain message
  $SELF announce <message>         broadcast it highlighted
  $SELF players                    who is online
  $SELF run <command> [args...]    any console command
  $SELF presence [ls|park|unpark]  park or restore the bots and the agent

environment:
  MC_NAMESPACE   namespace to look in (default: $NAMESPACE)
  MC_SELECTOR    label selector for the server pod
EOF
}

case "${1:-}" in
  ""|status)  shift || true; cmd_status ;;
  say)        shift; cmd_say "$@" ;;
  announce)   shift; cmd_announce "$@" ;;
  players)    shift; cmd_players ;;
  run)        shift; cmd_run "$@" ;;
  presence)   shift; cmd_presence "$@" ;;
  -h|--help|help) usage ;;
  *)          err "unknown command: $1" "$SELF --help" ;;
esac
